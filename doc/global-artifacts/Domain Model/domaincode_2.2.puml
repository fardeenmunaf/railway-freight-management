@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
hide circle
hide methods

title "Logistics On Rails - Domain Model (v2.2 - Final)"

' === RAILWAY INFRASTRUCTURE ===
class Line {
    id
    name
    owner
}

class LineSegment {
    id
    gauge
    maxWeight
    speedLimit
    isElectrified
    trackType
    length
    trackCount            ' single | double (supports queries in USBD16)
    voltage               ' optional: for electrified segments
    frequency             ' optional: for electrified segments
}

class Station {
    id
    name
    coordinates           ' lat,lon
    isCity
    isMainStation
    country
    timeZoneGroup
}

class Terminal {
    id
    name
    type
    hasGrainSilo          ' needed for USBD30
    hasWarehouse          ' to distinguish terminal capabilities
}

class FreightYard {
    id
    name
    capacity
}

class Siding {
    id
    name
    length
}

' === ROLLING STOCK ===
class Operator {
    id
    name
    license
}

class Locomotive {
    id
    registrationNumber
    operatorId
    type                  ' diesel | electric | hybrid
    gauge
    weight
    power
    acceleration
    fuelCapacity
    voltage               ' for electric locomotives (nullable)
    frequency             ' for electric locomotives (nullable)
    supportsMultipleGauges ' boolean (for USBD28)
}

class LocomotiveModel {
    make
    model
    entryYear
    type
    power
    acceleration
    dimensions
    totalWeight
    fuelCapacity
    gauge
    voltage
    frequency
    supportsMultipleGauges
}

class Wagon {
    id
    registrationNumber
    operatorId
    type                  ' Boxcar, Flatcar, Tank, Hopper, Refrigerated
    subType               ' e.g., ChemicalTank, MineralOil, PressureGas
    payload
    tare
    volumeCapacity
    dimensions
    gauge
}

class WagonModel {
    type
    subType
    payload
    tare
    volumeCapacity
    dimensions
    gauge
}

class Train {
    id
    serviceNumber
    plannedStart
    plannedEnd
    status
}

' === OPERATIONS ===
class Freight {
    id
    weight
    volume
    commodityType         ' grain, chemical, container, etc. (USEI/USBD relevance)
}

class Route {
    id
    name
    type                  ' simple | complex
}

class Path {
    id
    distance
    travelTime
}

class Journey {
    id
    departureTime
    arrivalTime
    actualStartTime
    actualEndTime
    status
}

' === STATION / ARQCP ENTITIES ===
class Sensor {
    id
    type                  ' temperature | humidity | ...
    unit
    lastReading
    installedAt           ' stationId
}

class LightSignal {
    id
    trackNumber
    state                 ' GREEN | YELLOW | RED | BLINKING_RED
    controlledAt          ' stationId
}

' === WAREHOUSE MANAGEMENT ===
class Warehouse {
    id
    name
    totalCapacity
    hasRefrigeration
    hasGrainSilo
}

class Aisle {
    id
    number
    width
}

class Bay {
    id
    number
    capacityBoxes
    currentOccupancy
}

class UnloadingDock {
    id
    number
    maxCapacity
}

class Box {
    id
    sku
    qty
    expiryDate
    receivedAt
    weight
}

class Product {
    sku
    name
    category
    unit
    volume
    unitWeight
    description
}

class Order {
    id
    customerId
    dueDate
    priority
    status
}

class OrderLine {
    lineNo
    qty
    unitPrice
}

class Return {
    id
    qty
    reason
    timestamp
    expiryDate
    condition
}

' === USERS ===
class User {
    id
    name
    email
    role
    permissions
}

class TrainDriver {
    licenseNumber
    licenseExpiry
    certifications
}

class StationMaster {
    stationId
    authorityLevel
}

class StorageManager {
    warehouseId
    specializations
}

class FreightManager {
    terminalId
    experience
}

class SchedulerPlanner {
    planningScope
    expertise
}

class TerminalOperator {
    operatorCode
    shift
}

class Customer {
    companyName
    contactInfo
    creditRating
}

' === RELATIONSHIPS ===

' Infrastructure relationships
Line "1" -- "*" LineSegment : composed of >
LineSegment "*" -- "2" Station : connects >
Station "1" -- "*" Terminal : has >
Station "1" -- "*" FreightYard : has >
Station "1" -- "*" Siding : has >
Station "1" -- "*" Sensor : monitors >        ' ARQCP sensors in each station (v2.2).
Station "1" -- "*" LightSignal : controls >   ' Light signs per track.

' Rolling stock relationships
Operator "1" -- "*" Locomotive : owns >
Operator "1" -- "*" Wagon : owns >
Locomotive "1" -- "1" LocomotiveModel : is described by >
Wagon "1" -- "1" WagonModel : is described by >
Train "1" -- "1..*" Locomotive : uses >
Train "1" -- "*" Wagon : composed of >

' Operations relationships
Journey "1" -- "1" Train : assigns >
Journey "1" -- "1" Route : follows >
Route "1" -- "*" Path : contains >
Path "*" -- "2..*" Station : passes through >
Freight "1" -- "*" Wagon : transported by >
Freight "*" -- "1" Station : origin >
Freight "*" -- "1" Station : destination >
SchedulerPlanner "1" -- "*" Journey : schedules >  ' Planner/Scheduler now schedules journeys (v2.2).

' Warehouse relationships
Terminal "1" -- "*" Warehouse : contains >
Warehouse "1" -- "*" Aisle : organized in >
Aisle "1" -- "*" Bay : contains >
Warehouse "1" -- "*" UnloadingDock : has >
UnloadingDock "1" -- "*" Wagon : unloads >   ' unloading docks linked to wagons arriving
Bay "1" -- "*" Box : stores >
Box "*" -- "1" Product : contains >
Wagon "*" -- "*" Box : transports >

' Order management
Customer "1" -- "*" Order : places >
Order "1" -- "*" OrderLine : composed of >
OrderLine "*" -- "1" Product : requests >
Order "*" -- "*" Freight : generates >

' Returns management (USEI05 rules reflected by Return entity usage)
Return "*" -- "1" Product : returned item >
Return "*" -- "1" Customer : returned by >

' User relationships / inheritance
User <|-- TrainDriver
User <|-- StationMaster
User <|-- StorageManager
User <|-- FreightManager
User <|-- SchedulerPlanner
User <|-- TerminalOperator
User <|-- Customer

' User associations
StationMaster "1" -- "1" Station : manages >
StorageManager "1" -- "1..*" Warehouse : manages >
FreightManager "1" -- "1" Terminal : manages freight >
TrainDriver "*" -- "*" Train : operates >
SchedulerPlanner "1" -- "*" Route : plans >
TerminalOperator "1" -- "1" Terminal : operates >

note bottom of Terminal
    Terminal is a specialized station area for freight operations; it may
    include warehouses, unloading docks and grain silos (v2.2 addition).
end note

note bottom of Sensor
    Sensors (temperature, humidity) are required per-station for ARQCP.
    Each station must expose sensor readings and a synoptic board (Sprint
    ARQCP requirements).
end note

note bottom of Locomotive
    Electric locomotives may expose voltage/frequency; some locomotives
    support multiple gauges (USBD28 / USBD29 scope).
end note

@enduml