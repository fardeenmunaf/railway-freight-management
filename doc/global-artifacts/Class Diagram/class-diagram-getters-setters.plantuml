    -payload_t
    -volume_m3
    -length_m
    -width_m
    -height_m
    -created_at
    -updated_at
    +getWagonId()
    +setWagonId()
    +getOperatorId()
    +setOperatorId()
    +getWagonType()
    +setWagonType()
    +getTareT()
    +setTareT()
    +getPayloadT()
    +setPayloadT()
    +getVolumeM3()
    +setVolumeM3()
    +getLengthM()
    +setLengthM()
    +getWidthM()
    +setWidthM()
    +getHeightM()
    +setHeightM()
    +getCreatedAt()
    +setCreatedAt()
    +getUpdatedAt()
    +setUpdatedAt()
}

class WagonType {
    -wagon_type_id
    -name
