    +getTrainStopId()
    +setTrainStopId()
    +getServiceId()
    +setServiceId()
    +getFacilityId()
    +setFacilityId()
    +getParkingTrack()
    +setParkingTrack()
    +getPosition()
    +setPosition()
    +getSchedArr()
    +setSchedArr()
    +getSchedDep()
    +setSchedDep()
    +getPlannedStopTime()
    +setPlannedStopTime()
    +getActArr()
    +setActArr()
    +getActDep()
    +setActDep()
    +getActStopTime()
    +setActStopTime()
}

' --- Items and Inventory ---
class Item {
    -item_id
    -item_category_id
    -sku
    -name
    -uom
    -volume
    -unit_weight
    +getItemId()
    +setItemId()
    +getItemCategoryId()
    +setItemCategoryId()
    +getSku()
    +setSku()
    +getName()
    +setName()
    +getUom()
    +setUom()
    +getVolume()
    +setVolume()
    +getUnitWeight()
    +setUnitWeight()
}

class ItemCategory {
    -category_id
    -name
    +getCategoryId()
    +setCategoryId()
    +getName()
    +setName()
}

class InventoryLot {
    -lot_id
    -sku
