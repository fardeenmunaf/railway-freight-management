    +getOrderId()
    +setOrderId()
    +getStatus()
    +setStatus()
    +getPriority()
    +setPriority()
    +getDueDate()
    +setDueDate()
    +getCreatedAt()
    +setCreatedAt()
}

class OrderLine {
    -order_line_id
