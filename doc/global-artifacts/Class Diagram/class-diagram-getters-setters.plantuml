    -updated_at
    +getWagonTypeId()
    +setWagonTypeId()
    +getName()
    +setName()
    +getCreatedAt()
    +setCreatedAt()
    +getUpdatedAt()
    +setUpdatedAt()
}

class WagonGauge {
    -wagon_id
    -gauge_id
    +getWagonId()
    +setWagonId()
    +getGaugeId()
    +setGaugeId()
}

class ParkingQueue {
    -parking_queue_id
    -parking_track_id
    -wagon_id
