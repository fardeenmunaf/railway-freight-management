    +getLotId()
    +setLotId()
    +getSku()
    +setSku()
    +getBoxCode()
    +setBoxCode()
    +getExpDate()
    +setExpDate()
    +getReceivedDate()
    +setReceivedDate()
}

class InventoryBalance {
    -balance_id
