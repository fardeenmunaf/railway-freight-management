@startuml

skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
hide circle

!theme plain
skinparam backgroundColor white
skinparam class {
    BackgroundColor white
    BorderColor black
    ArrowColor black
}
skinparam package {
    BackgroundColor lightgray
    BorderColor black
}

title Logistics On Rails - Class Diagram

' --- User and Company Management ---
class Company {
    -company_id
    -name
    +getCompanyId()
    +setCompanyId()
    +getName()
    +setName()
}

class User {
    -user_id
    -username
    -email
    -password
    -company_id
    -is_active
    -created_at
    +getUserId()
    +setUserId()
    +getUsername()
    +setUsername()
    +getEmail()
    +setEmail()
    +getPassword()
    +setPassword()
    +getCompanyId()
    +setCompanyId()
    +getIsActive()
    +setIsActive()
    +getCreatedAt()
    +setCreatedAt()
}

class Role {
    -role_id
    -name
    +getRoleId()
    +setRoleId()
    +getName()
    +setName()
}

class UserRole {
    -user_id
    -role_id
    +getUserId()
    +setUserId()
    +getRoleId()
    +setRoleId()
}

' --- Railway Infrastructure ---
class Gauge {
    -gauge_id
    -name
    -size_mm
    +getGaugeId()
    +setGaugeId()
    +getName()
    +setName()
    +getSizeMm()
    +setSizeMm()
}

class Line {
    -line_id
    -owner_id
    +getLineId()
    +setLineId()
    +getOwnerId()
    +setOwnerId()
}

class LineSegment {
    -segment_id
    -line_id
    -length_km
    -track_type_id
    -electrif_type_id
    -gauge_id
    -max_weight_kg_m
    -speed_limit_kmh
    -single_track
    -position
    +getSegmentId()
    +setSegmentId()
    +getLineId()
    +setLineId()
    +getLengthKm()
    +setLengthKm()
    +getTrackTypeId()
    +setTrackTypeId()
    +getElectrifTypeId()
    +setElectrifTypeId()
    +getGaugeId()
    +setGaugeId()
    +getMaxWeightKgM()
    +setMaxWeightKgM()
    +getSpeedLimitKmh()
    +setSpeedLimitKmh()
    +getSingleTrack()
    +setSingleTrack()
    +getPosition()
    +setPosition()
}

class TrackType {
    -track_type_id
    -name
    +getTrackTypeId()
    +setTrackTypeId()
    +getName()
    +setName()
}

class ElectrificationType {
    -electrif_type_id
    -name
    +getElectrifTypeId()
    +setElectrifTypeId()
    +getName()
    +setName()
}

class Facility {
    -facility_id
    -name
    -facility_type_id
    -lat
    -lon
    -is_intermodal
    +getFacilityId()
    +setFacilityId()
    +getName()
    +setName()
    +getFacilityTypeId()
    +setFacilityTypeId()
    +getLat()
    +setLat()
    +getLon()
    +setLon()
    +getIsIntermodal()
    +setIsIntermodal()
}

class FacilityType {
    -facility_type_id
    -name
    +getFacilityTypeId()
    +setFacilityTypeId()
    +getName()
    +setName()
}

class FacilityFeature {
    -facility_id
    -feature_id
    +getFacilityId()
    +setFacilityId()
    +getFeatureId()
    +setFeatureId()
}

class FacilityFeatureType {
    -feature_id
    -name
    +getFeatureId()
    +setFeatureId()
    +getName()
    +setName()
}

class ParkingTrack {
    -parking_track_id
    -line_id
    -facility_id
    -name
    -capacity_wagons
    +getParkingTrackId()
    +setParkingTrackId()
    +getLineId()
    +setLineId()
    +getFacilityId()
    +setFacilityId()
    +getName()
    +setName()
    +getCapacityWagons()
    +setCapacityWagons()
}

class LineSegmentFacility {
    -segment_facility_id
    -line_segment_id
    -facility_id
    +getSegmentFacilityId()
    +setSegmentFacilityId()
    +getLineSegmentId()
    +setLineSegmentId()
    +getFacilityId()
    +setFacilityId()
}

' --- Rolling Stock ---
class Locomotive {
    -locomotive_id
    -operator_id
    -locomotive_type
    -brand
    -model
    -year
    -power_kw
    -acceleration_ms2
    -length_m
    -width_m
    -height_m
    -max_weight_t
    -total_weight_t
    -num_bogies
    -created_at
    -updated_at
    +getLocomotiveId()
    +setLocomotiveId()
    +getOperatorId()
    +setOperatorId()
    +getLocomotiveType()
    +setLocomotiveType()
    +getBrand()
    +setBrand()
    +getModel()
    +setModel()
    +getYear()
    +setYear()
    +getPowerKw()
    +setPowerKw()
    +getAccelerationMs2()
    +setAccelerationMs2()
    +getLengthM()
    +setLengthM()
    +getWidthM()
    +setWidthM()
    +getHeightM()
    +setHeightM()
    +getMaxWeightT()
    +setMaxWeightT()
    +getTotalWeightT()
    +setTotalWeightT()
    +getNumBogies()
    +setNumBogies()
    +getCreatedAt()
    +setCreatedAt()
    +getUpdatedAt()
    +setUpdatedAt()
}

class LocomotiveType {
    -locomotive_type_id
    -name
    -created_at
    -updated_at
    +getLocomotiveTypeId()
    +setLocomotiveTypeId()
    +getName()
    +setName()
    +getCreatedAt()
    +setCreatedAt()
    +getUpdatedAt()
    +setUpdatedAt()
}

class LocomotiveDiesel {
    -locomotive_id
