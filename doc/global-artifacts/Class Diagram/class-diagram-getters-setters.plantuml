    +getReturnId()
    +setReturnId()
    +getOrigOrderId()
    +setOrigOrderId()
    +getReason()
    +setReason()
    +getStatus()
    +setStatus()
    +getReceivedAt()
    +setReceivedAt()
}

class ReturnLine {
    -return_line_id
    -return_id
    -sku
    -qty
