    +getReturnLineId()
    +setReturnLineId()
    +getReturnId()
    +setReturnId()
    +getSku()
    +setSku()
    +getQty()
    +setQty()
    +getCondition()
    +setCondition()
}

class QuarantineHold {
    -qhold_id
    -return_id
    -status
    -created_at
    -released_at
    +getQholdId()
    +setQholdId()
    +getReturnId()
    +setReturnId()
    +getStatus()
    +setStatus()
    +getCreatedAt()
    +setCreatedAt()
    +getReleasedAt()
    +setReleasedAt()
}

class QaInspection {
    -qa_id
    -return_line_id
    -status
    -inspected_at
    +getQaId()
    +setQaId()
    +getReturnLineId()
    +setReturnLineId()
    +getStatus()
    +setStatus()
    +getInspectedAt()
    +setInspectedAt()
}

' --- Picking Operations ---
class Cart {
    -cart_id
    -nome
    -max_weight
    +getCartId()
    +setCartId()
    +getNome()
    +setNome()
    +getMaxWeight()
    +setMaxWeight()
}

class PickWave {
    -wave_id
    -cart_id
    -strategy
    -status
    -created_at
    +getWaveId()
    +setWaveId()
    +getCartId()
    +setCartId()
    +getStrategy()
    +setStrategy()
    +getStatus()
    +setStatus()
    +getCreatedAt()
    +setCreatedAt()
}

class PickTask {
    -pick_id
    -wave_id
    -order_line_id
    -balance_id
    -qty
    -pos_seq
    +getPickId()
    +setPickId()
    +getWaveId()
    +setWaveId()
    +getOrderLineId()
    +setOrderLineId()
    +getBalanceId()
    +setBalanceId()
    +getQty()
    +setQty()
    +getPosSeq()
    +setPosSeq()
}

' --- Relationships ---
Company ||--o{ User : employs
User ||--o{ UserRole : has
Role ||--o{ UserRole : assigned_to

Company ||--o{ Line : owns
Line ||--o{ LineSegment : composed_of
Line ||--o{ ParkingTrack : has

LineSegment }o--|| TrackType : has
LineSegment }o--|| ElectrificationType : uses
LineSegment }o--|| Gauge : has
LineSegment ||--o{ LineSegmentFacility : connects_to
LineSegmentFacility }o--|| Facility : at

Facility }o--|| FacilityType : is_type
Facility ||--o{ FacilityFeature : has
FacilityFeature }o--|| FacilityFeatureType : of_type
Facility ||--o{ ParkingTrack : contains
Facility ||--o{ Warehouse : contains

User ||--o{ Locomotive : operates
User ||--o{ Wagon : operates
Locomotive }o--|| LocomotiveType : is_type
Locomotive ||--o{ LocomotiveDiesel : specializes
Locomotive ||--o{ LocomotiveGauge : supports
Wagon }o--|| WagonType : is_type
Wagon ||--o{ WagonGauge : supports

Gauge ||--o{ LocomotiveGauge : compatible
Gauge ||--o{ WagonGauge : compatible

ParkingTrack ||--o{ ParkingQueue : queues
ParkingQueue }o--|| Wagon : contains

Train }o--|| User : operated_by
Train ||--o{ TrainService : scheduled
TrainService ||--o{ ServiceLocomotive : uses
TrainService ||--o{ TrainStop : stops_at
ServiceLocomotive }o--|| Locomotive : uses
ServiceLocomotive ||--o{ TrainServiceComposition : pulls
TrainServiceComposition }o--|| Wagon : includes
TrainStop }o--|| Facility : at
TrainStop }o--|| ParkingTrack : uses

Item }o--|| ItemCategory : belongs_to
Item ||--o{ InventoryLot : tracked_in
InventoryLot ||--o{ InventoryBalance : stored_in
InventoryBalance }o--|| WarehouseBay : located_at
InventoryLot ||--o{ InventoryMove : moved

Warehouse ||--o{ WarehouseAisle : organized_in
WarehouseAisle ||--o{ WarehouseBay : contains

Order ||--o{ OrderLine : contains
OrderLine }o--|| Item : requests
ReturnOrder ||--o{ ReturnLine : contains
ReturnLine }o--|| Item : returns
ReturnOrder ||--o{ QuarantineHold : may_hold
ReturnLine ||--o{ QaInspection : inspected

Cart ||--o{ PickWave : uses
PickWave ||--o{ PickTask : contains
PickTask }o--|| OrderLine : picks_for
PickTask }o--|| InventoryBalance : from

@enduml