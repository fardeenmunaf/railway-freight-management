    +getMoveId()
    +setMoveId()
    +getLotId()
    +setLotId()
    +getFromBayId()
    +setFromBayId()
    +getToBayId()
    +setToBayId()
    +getQty()
    +setQty()
    +getReason()
    +setReason()
    +getCreatedAt()
    +setCreatedAt()
}

' --- Warehouse ---
class Warehouse {
    -warehouse_id
    -facility_id
    -name
    +getWarehouseId()
    +setWarehouseId()
    +getFacilityId()
    +setFacilityId()
    +getName()
    +setName()
}

class WarehouseAisle {
    -aisle_id
    -warehouse_id
    -aisle_no
    -unique_code
    +getAisleId()
    +setAisleId()
    +getWarehouseId()
    +setWarehouseId()
    +getAisleNo()
    +setAisleNo()
    +getUniqueCode()
    +setUniqueCode()
}

class WarehouseBay {
    -bay_id
    -aisle_id
